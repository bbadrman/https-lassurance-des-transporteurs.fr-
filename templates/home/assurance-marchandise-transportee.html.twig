{% extends 'base.html.twig' %}

{% block title %}Assurance marchandise transportée : devis en ligne{% endblock %}

{% block description %}
	<meta name="description" content="Obtenez votre assurance marchandise transportée au meilleur tarif. Comparez les garanties RC transport, tous risques et obtenez un devis personnalisé rapidement.">
{% endblock %}

{% block keywords %}
	<meta name="keywords" content="assurance marchandise transportée, RC transporteur, garantie tous risques marchandises, assurance transport de fret, couverture marchandise en transit, assurance cargo, responsabilité civile transporteur, assurance multirisque transport, contrat de transport routier, assurance logistique professionnelle">
{% endblock %}

{% block canonical %}
	<link rel="canonical" href="https://lassurance-des-transporteurs.fr/assurance-transport-de-marchandise/assurance-marchandise-transportee">
{% endblock %}

{% block opengraph %}
	<meta property="og:title" content="Assurance marchandise transportée : tarif et devis en ligne">
	<meta property="og:description" content="Protégez vos marchandises en transit avec une assurance adaptée. RC transport, tous risques, multimodal. Devis gratuit et personnalisé pour transporteurs professionnels.">
	<meta property="og:url" content="https://lassurance-des-transporteurs.fr/assurance-transport-de-marchandise/assurance-marchandise-transportee">
	<meta property="og:image" content="https://www.lassurance-des-transporteurs.fr/images/assurance-marchandise-transportee.webp">
	<meta property="og:type" content="website">
	<meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block body %}

	<!-- ═══════════════════════════════════════════════════
	     SECTION 1 — HERO + FORMULAIRE
	═══════════════════════════════════════════════════ -->
	<section class="py-0 lg:py-2 bg-green-to-br from-light via-surfaceHover to-light relative overflow-hidden">
		<div class="w-full mx-auto px-4 lg:px-40 relative z-10">
			<div class="flex flex-col lg:flex-row gap-1 lg:gap-2 items-stretch">

				<!-- Image — 70% -->
				<div class="order-2 lg:order-1 slide-in-left flex-1 lg:flex-[7]">
					<div class="relative h-full min-h-[300px] lg:min-h-[600px]">
						<div class="w-full h-full rounded-xl lg:rounded-3xl shadow-2xl overflow-hidden">
							<img src="{{ asset('images/assurance-marchandise-transportee.webp') }}"
								alt="Assurance marchandise transportée pour professionnels du transport"
								class="w-full h-full rounded-xl lg:rounded-3xl shadow-2xl" loading="lazy" width="1000" height="800"/>
 
						</div>
					</div>
				</div>

				<!-- Formulaire — 30% -->
				<div class="order-1 lg:order-2 slide-in-right flex-1 lg:flex-[3]">
					<div class="bg-surface rounded-xl lg:rounded-3xl shadow-2xl p-4 lg:p-6 card-hover border border-gray-100 w-full h-full">
						<div class="text-center mb-4 lg:mb-6 mt-8 lg:mt-12">
							<h2 class="text-base lg:text-2xl font-bold text-green mb-2 lg:mb-3 leading-tight">Comparez votre assurance marchandise transportée</h2>
							<div class="w-16 h-1 bg-green mx-auto rounded-full"></div>
						</div>

						{{ form_start(form, {'attr': {'id': 'formulaire', 'class': 'space-y-2 lg:space-y-3', 'data-turbo': 'false'}}) }}

						<!-- Raison sociale -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-building text-green text-sm"></i>
								</span>
								{{ form_widget(form.raison) }}
							</div>
							{{ form_errors(form.raison) }}
						</div>

						<!-- Démarrage activité -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-briefcase text-green text-sm"></i>
								</span>
								{{ form_widget(form.activite, {'attr': {'style': 'appearance: auto; -webkit-appearance: menulist;'}}) }}
							</div>
							{{ form_errors(form.activite) }}
						</div>


						<!-- Ancienne assurance résiliée -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-history text-green text-sm"></i>
								</span>
								{{ form_widget(form.ancienne, {
									'attr': {
										'style': 'appearance: auto; -webkit-appearance: menulist;',
										'id': 'ancienne_field',
										'onchange': 'toggleMotif(this.value)'
									}
								}) }}
							</div>
							{{ form_errors(form.ancienne) }}
						</div>

						<!-- Motif résiliation -->
						<div class="form-group" id="motif_group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-shield-alt text-green text-sm"></i>
								</span>
								{{ form_widget(form.motif, {'attr': {'style': 'appearance: auto; -webkit-appearance: menulist;'}}) }}
							</div>
							{{ form_errors(form.motif) }}
						</div>

						<script>
							function toggleMotif(value) {
								var motifGroup = document.getElementById('motif_group');
								var motifSelect = document.getElementById('transport_motif');
								var hide = (value === 'non');
								motifGroup.style.display = hide ? 'none' : '';
								if (motifSelect) motifSelect.disabled = hide;
							}
							document.addEventListener('DOMContentLoaded', function() {
								var ancienne = document.getElementById('ancienne_field');
								if (ancienne) toggleMotif(ancienne.value);
							});
						</script>

						<!-- Code Postal -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-map-marker-alt text-green text-sm"></i>
								</span>
								{{ form_widget(form.codepostal) }}
							</div>
							{{ form_errors(form.codepostal) }}
						</div>

						<!-- Nom -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-user text-green text-sm"></i>
								</span>
								{{ form_widget(form.nom) }}
							</div>
							{{ form_errors(form.nom) }}
						</div>

						<!-- Prénom -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-user-tag text-green text-sm"></i>
								</span>
								{{ form_widget(form.prenom) }}
							</div>
							{{ form_errors(form.prenom) }}
						</div>

						<!-- Email -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-envelope text-green text-sm"></i>
								</span>
								{{ form_widget(form.email) }}
							</div>
							{{ form_errors(form.email) }}
						</div>

						<!-- Téléphone -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-phone text-green text-sm"></i>
								</span>
								{{ form_widget(form.tele) }}
							</div>
							{{ form_errors(form.tele) }}
						</div>

						<!-- Consentement -->
						<div class="bg-white rounded-lg border border-blue-200 p-1.5 mt-2">
							<span class="text-xs text-gray-600 leading-tight block text-justify">
								En cliquant sur "Comparer", vous acceptez de transmettre vos informations à AKSAM ASSURANCES, qui accepte de les utiliser conformément à sa politique de confidentialité dans le but de vous fournir des propositions de devis d'assurance adaptées à votre recherche.
							</span>
						</div>

						<!-- Bouton -->
						<button type="submit" class="w-full bg-green text-white font-bold py-3 px-4 rounded-lg text-sm lg:text-base pulse-animation shadow-lg hover:shadow-2xl transition-all duration-300 mt-3">
							<i class="fas fa-calculator mr-2"></i>
							Comparer
						</button>

						{{ form_end(form) }}
					</div>
				</div>

			</div>
		</div>
	</section>


	<!-- ═══════════════════════════════════════════════════
	     SECTION 2 — H1
	═══════════════════════════════════════════════════ -->
	<section class="py-12 lg:py-20 bg-gradient-to-br from-light via-surfaceHover to-light relative overflow-hidden">
		<div class="container mx-auto px-4 lg:px-8 relative z-10">
			<div class="max-w-6xl mx-auto text-center">
				<h1 class="text-3xl lg:text-6xl font-bold text-green mb-6 leading-tight">
					Assurance marchandise transportée
				</h1>
				<div class="w-20 lg:w-24 h-1 bg-green mx-auto rounded-full mb-8"></div>
				<p class="speakable-intro text-lg lg:text-xl text-gray-700 max-w-4xl mx-auto leading-relaxed">
					Chaque année en France, des milliers de sinistres marchandises surviennent pendant le transport : vol, dommages liés à un accident de la route, avarie due à un choc ou une mauvaise manutention. Pour un transporteur professionnel, une PME logistique ou un chargeur, la question n'est pas de savoir si un incident peut arriver, mais quand. L'assurance marchandise transportée garantit la valeur du fret depuis l'enlèvement jusqu'à la livraison, couvrant aussi bien la responsabilité du transporteur que les pertes subies par le donneur d'ordre. Sans cette couverture, une seule palette de matériel électronique endommagée peut représenter plusieurs dizaines de milliers d'euros de préjudice non indemnisé.
				</p>
				<div class="mt-8">
					<a href="#formulaire" class="inline-block bg-green text-white font-bold py-4 px-8 rounded-2xl shadow-xl hover:shadow-2xl transition-all transform hover:scale-105 text-base lg:text-lg">
						<i class="fas fa-file-alt mr-2"></i>
						Comparez votre assurance marchandise transportée
					</a>
				</div>
			</div>
		</div>
	</section>


	<!-- ═══════════════════════════════════════════════════
	     SECTION 3 — ASSURANCE RC MARCHANDISE
	═══════════════════════════════════════════════════ -->
	<section class="py-12 lg:py-20 bg-surface">
		<div class="container mx-auto px-4 lg:px-8">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-8 lg:mb-14">
					<h2 class="text-2xl lg:text-5xl font-bold text-green mb-6">
						I. Assurance RC marchandise
					</h2>
					<div class="w-16 lg:w-24 h-1 bg-green mx-auto rounded-full mb-6"></div>
					<p class="text-gray-700 text-lg max-w-3xl mx-auto">
						L'assurance RC marchandise couvre la responsabilité civile du transporteur en cas de dommages ou de perte affectant les marchandises confiées. C'est le socle incontournable de toute activité de transport professionnel en France.
					</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">

					<!-- Cadre légal -->
					<div class="bg-light rounded-2xl p-6 lg:p-8 shadow-xl border border-gray-100">
						<div class="flex items-start gap-4 mb-4">
							<div class="w-14 h-14 bg-green-100 rounded-2xl flex items-center justify-center flex-shrink-0">
								<i class="fas fa-balance-scale text-green text-2xl"></i>
							</div>
							<div>
								<h3 class="text-xl font-bold text-green">1. Le cadre légal précis</h3>
							</div>
						</div>
						<p class="text-gray-700 leading-relaxed">
							Le transport routier intérieur est régi par l'article L.1432-4 du Code des transports, qui fixe la responsabilité de plein droit du transporteur en cas de perte, avarie ou retard. Pour les transports internationaux, c'est la Convention CMR qui s'applique, avec une limitation d'indemnisation fixée à 8,33 DTS par kilogramme de poids brut de la marchandise perdue ou avariée. Ces plafonds légaux sont souvent très inférieurs à la valeur réelle du fret — un transporteur de composants électroniques ou de produits pharmaceutiques s'expose à des découverts considérables si son contrat ne dépasse pas ces minima.
						</p>
					</div>

					<!-- Situations concrètes -->
					<div class="bg-light rounded-2xl p-6 lg:p-8 shadow-xl border border-gray-100">
						<div class="flex items-start gap-4 mb-4">
							<div class="w-14 h-14 bg-orange-100 rounded-2xl flex items-center justify-center flex-shrink-0">
								<i class="fas fa-exclamation-triangle text-orange-500 text-2xl"></i>
							</div>
							<div>
								<h3 class="text-xl font-bold text-green">2. Situations concrètes couvertes</h3>
							</div>
						</div>
						<ul class="space-y-3 text-gray-700">
							<li class="flex items-start gap-3">
								<i class="fas fa-check-circle text-green mt-0.5 flex-shrink-0"></i>
								<span>Camion percuté sur l'autoroute entraînant la destruction de 2 tonnes de produits agroalimentaires réfrigérés</span>
							</li>
							<li class="flex items-start gap-3">
								<i class="fas fa-check-circle text-green mt-0.5 flex-shrink-0"></i>
								<span>Chauffeur qui signe un bon de livraison sans réserves alors que les caisses étaient déjà choquées au chargement</span>
							</li>
							<li class="flex items-start gap-3">
								<i class="fas fa-check-circle text-green mt-0.5 flex-shrink-0"></i>
								<span>Vol de fret lors d'une halte nocturne sur une aire d'autoroute</span>
							</li>
							<li class="flex items-start gap-3">
								<i class="fas fa-check-circle text-green mt-0.5 flex-shrink-0"></i>
								<span>Avarie due à un défaut de manutention ou un arrimage insuffisant</span>
							</li>
						</ul>
					</div>

				</div>

				<div class="text-center">
					<a href="#formulaire" class="inline-block bg-green text-white font-bold py-4 px-10 rounded-2xl shadow-xl hover:shadow-2xl transition-all transform hover:scale-105 text-base lg:text-lg">
						<i class="fas fa-tag mr-2"></i>
						Obtenez un tarif RC marchandise adapté à votre activité
					</a>
				</div>
			</div>
		</div>
	</section>


	<!-- ═══════════════════════════════════════════════════
	     SECTION 4 — PRIX
	═══════════════════════════════════════════════════ -->
	<section class="py-12 lg:py-20 bg-light">
		<div class="container mx-auto px-4 lg:px-8">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-8 lg:mb-14">
					<h2 class="text-2xl lg:text-5xl font-bold text-green mb-6">
						II. Assurance marchandise transportée : prix
					</h2>
					<div class="w-16 lg:w-24 h-1 bg-green mx-auto rounded-full mb-6"></div>
					<p class="text-gray-700 text-lg max-w-3xl mx-auto">
						Le prix d'une assurance marchandise transportée dépend de plusieurs variables précises. La prime annuelle se calcule généralement en pourcentage de la valeur assurée des marchandises, avec un taux oscillant entre <strong>0,05 % et 0,30 %</strong> de la valeur du fret selon le niveau de garantie choisi.
					</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 mb-10">

					<!-- Fourchettes tarifaires -->
					<div class="bg-surface rounded-2xl p-6 lg:p-8 shadow-xl border border-gray-100">
						<h3 class="text-xl lg:text-2xl font-bold text-green mb-6 flex items-center gap-3">
							<i class="fas fa-euro-sign text-green"></i>
							1. Fourchettes tarifaires indicatives
						</h3>
						<div class="space-y-3 mb-6">
							<div class="flex items-center justify-between bg-green-50 rounded-xl px-4 py-3 border border-green-200">
								<div class="flex items-center gap-3">
									<i class="fas fa-box text-green text-lg"></i>
									<span class="font-semibold text-gray-800">Fret standard (route nationale)</span>
								</div>
								<span class="font-bold text-green">0,05 – 0,10 %/an</span>
							</div>
							<div class="flex items-center justify-between bg-blue-50 rounded-xl px-4 py-3 border border-blue-200">
								<div class="flex items-center gap-3">
									<i class="fas fa-laptop text-blue-600 text-lg"></i>
									<span class="font-semibold text-gray-800">Marchandises à haute valeur</span>
								</div>
								<span class="font-bold text-blue-700">0,15 – 0,30 %/an</span>
							</div>
							<div class="flex items-center justify-between bg-orange-50 rounded-xl px-4 py-3 border border-orange-200">
								<div class="flex items-center gap-3">
									<i class="fas fa-globe-europe text-orange-500 text-lg"></i>
									<span class="font-semibold text-gray-800">Transport international</span>
								</div>
								<span class="font-bold text-orange-600">majoré selon zone</span>
							</div>
						</div>
						<p class="text-gray-600 text-sm italic">
							Exemple concret : pour 200 000 €/mois de fret à valeur déclarée, la prime annuelle tous risques se situe autour de 2 400 à 3 600 €.
						</p>
					</div>

					<!-- Facteurs de variation -->
					<div class="bg-surface rounded-2xl p-6 lg:p-8 shadow-xl border border-gray-100">
						<h3 class="text-xl lg:text-2xl font-bold text-green mb-6 flex items-center gap-3">
							<i class="fas fa-sliders-h text-green"></i>
							2. Les 4 facteurs qui font varier la prime
						</h3>
						<ul class="space-y-4">
							<li class="flex items-start gap-3">
								<span class="w-7 h-7 bg-green text-white rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">1</span>
								<div>
									<p class="font-semibold text-gray-800">Nature du fret</p>
									<p class="text-gray-600 text-sm">Une marchandise fragile ou à forte valeur (œuvres d'art, électronique, bijoux) génère une prime plus élevée qu'un fret en vrac.</p>
								</div>
							</li>
							<li class="flex items-start gap-3">
								<span class="w-7 h-7 bg-green text-white rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">2</span>
								<div>
									<p class="font-semibold text-gray-800">Secteur géographique</p>
									<p class="text-gray-600 text-sm">Les trajets en zone urbaine dense ou vers des pays à risque élevé majorent la prime.</p>
								</div>
							</li>
							<li class="flex items-start gap-3">
								<span class="w-7 h-7 bg-green text-white rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">3</span>
								<div>
									<p class="font-semibold text-gray-800">Historique de sinistralité</p>
									<p class="text-gray-600 text-sm">Un transporteur sans sinistre sur 3 ans bénéficie généralement d'un coefficient réducteur sensible.</p>
								</div>
							</li>
							<li class="flex items-start gap-3">
								<span class="w-7 h-7 bg-green text-white rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">4</span>
								<div>
									<p class="font-semibold text-gray-800">Mode de conditionnement</p>
									<p class="text-gray-600 text-sm">Palette filmée, conteneur scellé, vrac en benne : chaque conditionnement modifie le risque d'avarie.</p>
								</div>
							</li>
						</ul>
					</div>

				</div>

				<div class="text-center">
					<a href="#formulaire" class="inline-block bg-green text-white font-bold py-4 px-10 rounded-2xl shadow-xl hover:shadow-2xl transition-all transform hover:scale-105 text-base lg:text-lg">
						<i class="fas fa-calculator mr-2"></i>
						Simulez le prix de votre assurance marchandise transportée
					</a>
				</div>
			</div>
		</div>
	</section>


	<!-- ═══════════════════════════════════════════════════
	     SECTION 5 — GARANTIE RC EN LIGNE
	═══════════════════════════════════════════════════ -->
	<section class="py-12 lg:py-20 bg-surface">
		<div class="container mx-auto px-4 lg:px-8">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-8 lg:mb-14">
					<h2 class="text-2xl lg:text-5xl font-bold text-green mb-6">
						III. Garantie RC marchandise en ligne
					</h2>
					<div class="w-16 lg:w-24 h-1 bg-green mx-auto rounded-full mb-6"></div>
					<p class="text-gray-700 text-lg max-w-3xl mx-auto">
						Souscrire une garantie RC marchandise en ligne est désormais possible pour la majorité des profils de transporteurs professionnels, à condition de disposer des bonnes informations et de ne pas sacrifier la qualité des garanties à la rapidité.
					</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">

					<!-- Exclusions à surveiller -->
					<div class="bg-light rounded-2xl p-6 lg:p-8 shadow-xl border border-gray-100">
						<h3 class="text-xl font-bold text-green mb-6 flex items-center gap-3">
							<i class="fas fa-exclamation-circle text-green"></i>
							1. Exclusions fréquentes à vérifier
						</h3>
						<div class="space-y-3">
							<div class="flex items-start gap-3 bg-red-50 rounded-xl p-3 border border-red-100">
								<i class="fas fa-times-circle text-red-500 mt-0.5 flex-shrink-0"></i>
								<span class="text-gray-700 text-sm">Franchise élevée sur les vols simples sans effraction</span>
							</div>
							<div class="flex items-start gap-3 bg-red-50 rounded-xl p-3 border border-red-100">
								<i class="fas fa-times-circle text-red-500 mt-0.5 flex-shrink-0"></i>
								<span class="text-gray-700 text-sm">Exclusion des marchandises non palettisées</span>
							</div>
							<div class="flex items-start gap-3 bg-red-50 rounded-xl p-3 border border-red-100">
								<i class="fas fa-times-circle text-red-500 mt-0.5 flex-shrink-0"></i>
								<span class="text-gray-700 text-sm">Absence de couverture pour le transport sous température dirigée</span>
							</div>
							<div class="flex items-start gap-3 bg-red-50 rounded-xl p-3 border border-red-100">
