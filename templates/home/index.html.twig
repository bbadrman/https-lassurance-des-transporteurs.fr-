	<!-- JAVASCRIPT PAGINATION FAQ (5 questions par page, réutilisable sur d'autres pages) -->
	<script>
		(function () {
const PER_PAGE = 5;
const container = document.getElementById('faq-container');
const pagination = document.getElementById('faq-pagination');
if (!container || !pagination) return;

const items = Array.from(container.querySelectorAll('.faq-item'));
const totalPages = Math.ceil(items.length / PER_PAGE);
if (totalPages <= 1) return;

function showPage(page, scroll) {
items.forEach((item, index) => {
const itemPage = Math.floor(index / PER_PAGE) + 1;
item.style.display = itemPage === page ? '' : 'none';
});

pagination.querySelectorAll('.faq-page-btn').forEach(btn => {
const isActive = Number(btn.dataset.page) === page;
btn.classList.toggle('bg-green', isActive);
btn.classList.toggle('text-white', isActive);
btn.classList.toggle('bg-white', !isActive);
btn.classList.toggle('text-gray-700', !isActive);
});

if (scroll) {
container.scrollIntoView({behavior: 'smooth', block: 'start'});
}
}

for (let page = 1; page <= totalPages; page++) {
const btn = document.createElement('button');
btn.type = 'button';
btn.dataset.page = page;
btn.textContent = page;
btn.className = 'faq-page-btn w-10 h-10 rounded-lg font-semibold border border-gray-200 shadow-sm transition-colors bg-white text-gray-700 hover:bg-gray-50';
btn.addEventListener('click', () => showPage(page, true));
pagination.appendChild(btn);
}

showPage(1, false);
})();
	</script>
	
	<script>
