{% extends 'base.html.twig' %}

{% block title %}Assurance transport marchandise : Protégez vos véhicules et cargaisons dès 89€/mois
{% endblock %}

{% block description %}
	<meta name="description" content="Assurance transport marchandise complète : véhicules, marchandises, RC pro. Devis gratuit en 2 min. Couverture 24/7, assistance dépannage, indemnisation rapide.">
{% endblock %}

{% block keywords %}
	<meta name="keywords" content="Assurance transport marchandise ">
{% endblock %}

{% block canonical %}
	<link rel="canonical" href="https://lassurance-des-transport.fr/assurance-transport-marchandise/">
{% endblock %}

{% block opengraph %}
	<meta property="og:title" content="Assurance Transport de Marchandises - Devis en Ligne | Aksam">
	<meta property="og:description" content="Assurez vos véhicules et marchandises transportées avec Aksam Assurance. Devis en ligne gratuit pour transporteurs professionnels.">
	<meta property="og:url" content="https://lassurance-des-transport.fr/assurance-transport-marchandise/">
	<meta property="og:image" content="https://lassurance-des-transport.fr/images/transport-marchandise.jpg">
	<meta property="og:type" content="website">
	<meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block body %}
	<section
		class="py-0 lg:py-2 bg-green-to-br from-light via-surfaceHover to-light relative overflow-hidden">
		<!-- Background decoration -->

		<div class="w-full mx-auto px-4 lg:px-40 relative z-10">
			<div
				class="flex flex-col lg:flex-row gap-1 lg:gap-2 items-stretch">

				<!-- Image Section - 70% -->
				<div class="order-2 lg:order-1 slide-in-left flex-1 lg:flex-[7]">
					<div class="relative h-full min-h-[300px] lg:min-h-[600px]">
						<div class="w-full h-full  rounded-xl lg:rounded-3xl shadow-2xl overflow-hidden">
							<img src="{{ asset('images/transport-marchandise.jpg') }}" alt="Conducteur professionnel" class="w-full h-full rounded-xl lg:rounded-3xl shadow-2xl " loading="lazy"/>
						</div>
					</div>
				</div>

				<!-- Form Section - 30% -->
				<div class="order-1 lg:order-2 slide-in-right flex-1 lg:flex-[3]">
					<div class="bg-surface rounded-xl lg:rounded-3xl shadow-2xl p-4 lg:p-6 card-hover border border-gray-100 h-full">
						<div class="text-center mb-4 lg:mb-6">

							<h2 class="text-base lg:text-2xl font-bold text-green mb-2 lg:mb-3 leading-tight">Complétez ce formulaire pour obtenir un tarif</h2>
							<div class="w-16 h-1 bg-green-to-r from-green mx-auto rounded-full"></div>
						</div>


						<!-- Nom -->
						{{ form_start(form, {'attr': {'id': 'formulaire', 'class': 'space-y-2 lg:space-y-3', 'data-turbo': 'false'}}) }}

						<!-- Nom -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-user text-green text-sm"></i>
								</span>
								{{ form_widget(form.nom) }}
							</div>
							{{ form_errors(form.nom) }}
						</div>

						<!-- Prénom -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-user-tag text-green text-sm"></i>
								</span>
								{{ form_widget(form.prenom) }}
							</div>
							{{ form_errors(form.prenom) }}
						</div>

						<!-- Raison sociale -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-building text-green text-sm"></i>
								</span>
								{{ form_widget(form.raison) }}
							</div>
							{{ form_errors(form.raison) }}
						</div>

						<!-- Activité -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-briefcase text-green text-sm"></i>
								</span>
								{{ form_widget(form.activite) }}
							</div>
							{{ form_errors(form.activite) }}
						</div>

						<!-- Véhicule assuré -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-shield-alt text-green text-sm"></i>
								</span>
								{{ form_widget(form.assurer) }}
							</div>
							{{ form_errors(form.assurer) }}
						</div>


						<!-- souhaiter assurer -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-shield-alt text-green text-sm"></i>
								</span>
								{{ form_widget(form.souhAssurer, {
                                  'attr': {
                              'style': 'appearance: auto; -webkit-appearance: menulist;'
                                         }
                                   }) }}
							</div>
							{{ form_errors(form.souhAssurer) }}
						</div>


						<!-- Code Postal -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-map-marker-alt text-green text-sm"></i>
								</span>
								{{ form_widget(form.codepostal) }}
							</div>
							{{ form_errors(form.codepostal) }}
						</div>

						<!-- Email -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-envelope text-green text-sm"></i>
								</span>
								{{ form_widget(form.email) }}
							</div>
							{{ form_errors(form.email) }}
						</div>

						<!-- Téléphone -->
						<div class="form-group">
							<div class="flex">
								<span class="inline-flex items-center px-2 py-2 bg-gray-50 border border-r-0 border-gray-200 rounded-l-lg text-gray-600">
									<i class="fas fa-phone text-green text-sm"></i>
								</span>
								{{ form_widget(form.tele) }}
							</div>
							{{ form_errors(form.tele) }}
						</div>

						<!-- Consent -->
						<div class="bg-white rounded-lg border border-green p-1.5 mt-2">
							<span class="text-xs text-gray-600 leading-tight block text-justify">
								En cliquant sur "Comparer", vous acceptez de transmettre vos informations à AKSAM ASSURANCES, qui accepte de les utiliser conformément à sa politique de confidentialité dans le but de vous fournir des propositions de devis d'assurance adaptées à votre recherche.
							</span>
						</div>

						<!-- Bouton -->
						<button type="submit" class="w-full bg-gold text-green font-bold py-3 px-4 rounded-lg text-sm lg:text-base pulse-animation shadow-lg hover:shadow-2xl transition-all duration-300 mt-3">
							<i class="fas fa-calculator mr-2"></i>
							Comparer
						</button>

						{{ form_end(form) }}

					</div>
				</div>
			</div>
		</div>
	</section>

