						<div class="w-full h-full rounded-xl lg:rounded-3xl shadow-2xl overflow-hidden">
							<img src="{{ asset('public/images/poids-lourd.jpg') }}" alt="Poids lourd transport de marchandises professionnel" class="w-full h-full rounded-xl lg:rounded-3xl shadow-2xl object-cover" loading="lazy" width="1000" height="800"/>
						</div>
					</div>
				</div>

				<!-- Formulaire — 30% -->
				<div class="order-1 lg:order-2 slide-in-right flex-1 lg:flex-[3]">
					<div class="bg-surface rounded-xl lg:rounded-3xl shadow-2xl p-4 lg:p-6 card-hover border border-gray-100 w-full h-full">
						<div class="text-center mb-4 lg:mb-6 mt-8 lg:mt-12">
							<h2 class="text-base lg:text-2xl font-bold text-green mb-2 lg:mb-3 leading-tight">Comparez les offres d'assurance poids lourd transport de marchandises</h2>
